# Copy to .env and fill in real values. Loaded from the project root.
ENV=production
HOST=0.0.0.0
PORT=8765
FLASK_DEBUG=0

LOG_DIR=logs
LOG_RETENTION_DAYS=3

# Browser — fully headless (no UI anywhere).
HEADLESS=1
# Use system Chrome (recommended on Linux): BROWSER_CHANNEL=chrome and
# CHROME_PATH=/usr/bin/google-chrome
# Or fall back to Playwright's bundled Chromium:
#   python -m playwright install chromium   and  BROWSER_CHANNEL=chromium
BROWSER_CHANNEL=chrome
CHROME_PATH=/usr/bin/google-chrome

# SQLite lives in backend/data/ by default (gitignored).
SQLITE_PATH=data/data.db

# DeepSeek — on by default.
DEEPSEEK_ENABLED=1
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_CHAT_TIMEOUT_S=300
DEEPSEEK_THINK_TIMEOUT_S=600
# Parallel browser workers (1–4). Each chat can run on its own page.
DEEPSEEK_WORKERS=2
DEEPSEEK_AUTO_LOGIN=1
DEEPSEEK_USERNAME=you@example.com
DEEPSEEK_PASSWORD=change-me
# Password-login breaker: at most N attempts per window, then cool down.
DEEPSEEK_LOGIN_MAX_ATTEMPTS=2
DEEPSEEK_LOGIN_WINDOW_S=7200
DEEPSEEK_LOGIN_COOLDOWNS=1800,7200,21600
# Outbound pacing: minimum gap (jittered ±30%) and rolling per-minute cap.
DEEPSEEK_MIN_GAP_S=9
DEEPSEEK_MAX_RPM=6

# ChatGPT — off by default. Set CHATGPT_ENABLED=1 to use.
CHATGPT_ENABLED=0
CHATGPT_PROXY=http://127.0.0.1:7890
CHATGPT_TIMEOUT_MS=120000
CHATGPT_CHAT_TIMEOUT_S=300
CHATGPT_CAPTCHA_TIMEOUT_S=600
# 1 = server auto-launches real Chrome with CDP (recommended for local).
CHATGPT_AUTO_LAUNCH_CHROME=1
CHATGPT_CDP_PORT=9222
# Optional: attach to an existing Chrome instead of auto-launch.
# CHATGPT_CDP_URL=http://127.0.0.1:9222
# Real Chrome path (not headless-shell). macOS default is Google Chrome.app.
# CHATGPT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 1 = only open headed browser; you log in manually (recommended).
CHATGPT_MANUAL_LOGIN=1
# Password auto-fill only when CHATGPT_MANUAL_LOGIN=0.
CHATGPT_AUTO_LOGIN=0
# Persistent profile (used by auto-launch Chrome)
# CHATGPT_USER_DATA_DIR=data/chatgpt-browser
CHATGPT_USERNAME=you@example.com
CHATGPT_PASSWORD=change-me

# Qwen — off by default. Set QWEN_ENABLED=1 to use.
QWEN_ENABLED=0
QWEN_TIMEOUT_MS=120000
QWEN_CHAT_TIMEOUT_S=300
QWEN_THINK_TIMEOUT_S=600
# Parallel browser workers (1–4). Each chat can run on its own page.
QWEN_WORKERS=2
QWEN_AUTO_LOGIN=1
QWEN_USERNAME=you@example.com
QWEN_PASSWORD=change-me

# Agnes — off by default. Set AGNES_ENABLED=1 to use.
AGNES_ENABLED=0
AGNES_PROXY=http://127.0.0.1:7890
AGNES_TIMEOUT_MS=120000
AGNES_CHAT_TIMEOUT_S=300
AGNES_THINK_TIMEOUT_S=600
# Parallel browser workers (1–4). Each chat can run on its own page.
AGNES_WORKERS=2
AGNES_AUTO_LOGIN=1
AGNES_USERNAME=you@example.com
AGNES_PASSWORD=change-me

# Doubao — off by default. Set DOUBAO_ENABLED=1 to use.
# Login is a QR code printed in the log. A successful scan is kept in
# DOUBAO_USER_DATA_DIR and sqlite, and reused on the next startup.
DOUBAO_ENABLED=0
DOUBAO_TIMEOUT_MS=120000
DOUBAO_CHAT_TIMEOUT_S=300
DOUBAO_THINK_TIMEOUT_S=600
DOUBAO_LOGIN_TIMEOUT_S=180
# DOUBAO_USER_DATA_DIR=data/doubao-browser
