# Copy to .env and fill in real values. Loaded from the project root.
ENV=production
HOST=0.0.0.0
PORT=8765
FLASK_DEBUG=0

LOG_DIR=logs
LOG_RETENTION_DAYS=3

# Browser — fully headless (no UI anywhere).
HEADLESS=1
# Use system Chrome (recommended on Linux): BROWSER_CHANNEL=chrome and
# CHROME_PATH=/usr/bin/google-chrome
# Or fall back to Playwright's bundled Chromium:
#   python -m playwright install chromium   and  BROWSER_CHANNEL=chromium
BROWSER_CHANNEL=chrome
CHROME_PATH=/usr/bin/google-chrome

# SQLite lives in backend/data/ by default (gitignored).
SQLITE_PATH=data/data.db

# DeepSeek account — password login works fully headless.
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_CHAT_TIMEOUT_S=300
DEEPSEEK_THINK_TIMEOUT_S=600
DEEPSEEK_AUTO_LOGIN=1
DEEPSEEK_USERNAME=you@example.com
DEEPSEEK_PASSWORD=change-me
