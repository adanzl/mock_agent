{
    "words": [
        "Tailwind",
        "Tailwindcss",
        "deepseek",
        "chatgpt",
        "qwen",
        "qwenchat",
        "qwenai",
        "agnes",
        "headless",
        "playwright",
        "dotenv",
        "levelname",
        "domcontentloaded",
        "pycache",
        "pytest",
        "infobars",
        "openai",
        "contenteditable",
        "turnstile",
        "captcha",
        "cdp",
    ],
    "ignorePaths": [
        ".env"
    ],
    "ignoreRegExpList": [
        "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*\\(",
        "\\([^\\)]*\\)",
        "\\b[a-zA-Z_][a-zA-Z0-9_]*\\.[a-zA-Z_][a-zA-Z0-9_]*\\s*",
        "^\\s*from\\s+\\S+\\s+import\\s+.+$",
        "^\\s*import\\s+.+$"
    ]
}